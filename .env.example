# Copiez ce fichier en .env puis remplissez-le. NE JAMAIS commiter .env.

# Mode : paper (simulation locale) | testnet (Binance Spot Testnet) | live (argent réel)
TRADING_MODE=paper
# Requis UNIQUEMENT pour live. Laissez vide tant que non validé explicitement.
LIVE_CONFIRMATION=

# Clés Binance (testnet.binance.vision pour le testnet). Retrait DÉSACTIVÉ.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# IDs Telegram autorisés, séparés par des virgules
TELEGRAM_ALLOWED_IDS=8233884809

# Marché
PAIRS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT
TIMEFRAME=15m
LOOP_INTERVAL_SECONDS=60

# Capital et risque
STARTING_CAPITAL_USDT=80
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_PCT=5.0
COOLDOWN_MINUTES=60
FEE_RATE_PCT=0.1

# IA (facultatif, désactivée par défaut)
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=

DB_PATH=data/robot.db
LOG_FILE=logs/trading.log

# Supabase (synchronisation facultative ; SQLite reste la base principale)
SUPABASE_SYNC=false
SUPABASE_URL=https://mxexypbugttnptlxmpae.supabase.co
# Clé service_role : secrète, uniquement sur le VPS
SUPABASE_SERVICE_KEY=
